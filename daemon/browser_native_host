#!/usr/bin/env python3
import sys
import json
import struct
import os
import subprocess
import time
import urllib.request

DAEMON_SCRIPT = os.path.expanduser("~/.local/share/linux-download-manager/bin/ldm_daemon.py")
DAEMON_URL = "http://127.0.0.1:18900/api/downloads/add"
LOG_FILE = os.path.expanduser("~/.local/share/linux-download-manager/host.log")

def log(msg):
    try:
        with open(LOG_FILE, "a", encoding="utf-8") as f:
            f.write(f"[{time.strftime('%Y-%m-%d %H:%M:%S')}] {msg}\n")
    except Exception:
        pass

def send_message(obj):
    encoded = json.dumps(obj).encode("utf-8")
    sys.stdout.buffer.write(struct.pack("@I", len(encoded)))
    sys.stdout.buffer.write(encoded)
    sys.stdout.buffer.flush()

def read_message():
    raw_length = sys.stdin.buffer.read(4)
    if not raw_length or len(raw_length) < 4:
        return None
    message_length = struct.unpack("@I", raw_length)[0]
    raw_message = sys.stdin.buffer.read(message_length)
    return json.loads(raw_message.decode("utf-8"))

def ensure_daemon():
    try:
        urllib.request.urlopen("http://127.0.0.1:18900/api/downloads", timeout=0.5)
        return
    except Exception:
        pass

    log("Starting daemon...")
    subprocess.Popen([sys.executable, DAEMON_SCRIPT], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    for _ in range(20):
        time.sleep(0.1)
        try:
            urllib.request.urlopen("http://127.0.0.1:18900/api/downloads", timeout=0.5)
            log("Daemon ready.")
            return
        except Exception:
            pass
    log("Warning: daemon did not start in time.")

def notify(title, message):
    try:
        subprocess.run(["notify-send", "-a", "Linux Download Manager", title, message], check=False)
    except Exception:
        pass

def main():
    log("Native host invoked.")
    ensure_daemon()

    while True:
        try:
            msg = read_message()
            if msg is None:
                break
            log(f"Received msg from Chrome: url={msg.get('url')} isPlaylist={msg.get('isPlaylist')} format={msg.get('format')} title={msg.get('sourceTitle')}")

            url = msg.get("url")
            title = msg.get("sourceTitle") or "video_download"

            if url and ("/sublist_" in url or "/txt/sublist" in url):
                import re
                master_cand = re.sub(r'/sublist_[^/]+\.txt', '/master.txt', url)
                try:
                    chk_hdrs = dict(msg.get("httpHeaders", {}))
                    if "closeload" in url or "cdnimages" in url:
                        chk_hdrs["Referer"] = "https://closeload.filmmakinesi.to/"
                    elif "rapid" in url or "rapidrame" in url:
                        chk_hdrs["Referer"] = "https://rapid.filmmakinesi.to/"
                    chk_req = urllib.request.Request(master_cand, headers=chk_hdrs)
                    with urllib.request.urlopen(chk_req, timeout=2) as chk_resp:
                        if chk_resp.status == 200:
                            log(f"Host auto-upgraded {url} -> {master_cand}")
                            url = master_cand
                except Exception:
                    pass

            # Forward to daemon
            fwd_hdrs = dict(msg.get("httpHeaders", {}))
            if url and ("closeload" in url or "cdnimages" in url):
                fwd_hdrs["Referer"] = "https://closeload.filmmakinesi.to/"
            elif url and ("rapid" in url or "rapidrame" in url):
                fwd_hdrs["Referer"] = "https://rapid.filmmakinesi.to/"

            req_data = json.dumps({
                "url": url,
                "title": title,
                "headers": fwd_hdrs,
                "saveDir": msg.get("saveDir"),
                "sourcePageUrl": msg.get("sourcePageUrl"),
                "format": msg.get("format"),
                "forceYtdlp": msg.get("forceYtdlp", False),
                "isPlaylist": msg.get("isPlaylist", False)
            }).encode("utf-8")

            req = urllib.request.Request(DAEMON_URL, data=req_data, headers={"Content-Type": "application/json"})
            try:
                urllib.request.urlopen(req, timeout=2)
                log(f"Successfully sent to daemon: {title}")
                notify("Linux Download Manager", f"İndirme paneline eklendi:\n{title}")
            except Exception as e:
                log(f"Failed to send to daemon: {e}")

            send_message({"ok": True, "staged": True})
        except Exception as e:
            log(f"Error in host loop: {e}")
            break

if __name__ == "__main__":
    main()
